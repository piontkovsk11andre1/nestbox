# Copy this file to .env next to docker-compose.yaml and adjust as needed.

# Docker Compose
# Set a unique slug for this project before starting Nestbox.
COMPOSE_PROJECT_NAME=nestbox-change-me

# Workspace exposed to PHP and OpenCode. Use . when Nestbox fills the selected
# directory, or .. when this installation is <workspace>/.nestbox.
WORKSPACE_PATH=.

# Use 127.0.0.1 for local access only or 0.0.0.0 for all interfaces.
BIND_ADDRESS=127.0.0.1

# Published port shared by Nestbox and OpenCode. The installer confirms this
# default is available and asks before selecting another port.
WEB_PORT=4180

# Optional public path when a reverse proxy strips this prefix before forwarding.
NESTBOX_URL_PREFIX=

# Optional absolute browser origin when the agent.* host cannot be derived from
# the incoming Nestbox host, for example https://agent.project.example.
NESTBOX_OPENCODE_PUBLIC_URL=

# Runtime ownership
APP_UID=1000
APP_GID=1000

# Secrets
# OpenCode receives every variable in this file. Keep unrelated secrets out.
# Leave the server password empty to disable HTTP basic authentication.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
