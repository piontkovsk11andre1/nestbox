{
  "name": "@p10i/create-nestbox",
  "version": "0.5.0",
  "description": "Create Nestbox projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-nestbox": "bin/create-nestbox.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "docker/",
    "home/",
    "tests/",
    "host-runner.mjs",
    "package.host.json",
    "docker-compose.yaml",
    ".dockerignore",
    ".env.example",
    ".gitattributes",
    "template.gitignore",
    "INSTALL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!docker/control/__pycache__/",
    "!**/*.pyc",
    "!**/node_modules/",
    "!home/code/scripts-bundle.js",
    "!home/code/scripts-bundle.css"
  ],
  "scripts": {
    "host": "node host-runner.mjs",
    "test:host": "node tests/host-runner.mjs",
    "test": "node tests/control.mjs && node tests/host-runner.mjs && node tests/creator.mjs",
    "prepack": "node scripts/check-package.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piontkovsk11andre1/nestbox.git"
  },
  "bugs": {
    "url": "https://github.com/piontkovsk11andre1/nestbox/issues"
  },
  "homepage": "https://github.com/piontkovsk11andre1/nestbox#readme"
}
