{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  },
  "instructions": ["/etc/opencode/instructions.md", "/etc/opencode/instance.md"],
  "mcp": {
    "do-md": {
      "type": "local",
      "command": ["do-md-mcp", "--url", "{env:NESTBOX_DO_MD_URL}", "--root", "/documents", "--timeout-ms", "{env:NESTBOX_DO_MD_TIMEOUT_MS}"],
      "enabled": true
    },
    "control": {
      "type": "local",
      "command": ["node", "/etc/opencode/control-mcp.js"],
      "enabled": true,
      "environment": {
        "NESTBOX_CONTROL_URL": "{env:NESTBOX_CONTROL_URL}",
        "NESTBOX_CONTROL_TIMEOUT_MS": "30000"
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/nestbox/**": "allow",
      "/documents/**": "allow",
      "/workspace/**": "allow"
    }
  }
}
